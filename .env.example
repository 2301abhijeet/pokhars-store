# Firebase Web app config (public client values; Firebase rules protect data).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDx4DFCSeMMu-9pDV0tz7uXUcRhogXK7BA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pokhars-store.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pokhars-store
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pokhars-store.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1073425965119
NEXT_PUBLIC_FIREBASE_APP_ID=1:1073425965119:web:fc6a56252d17c4abbe988a

# Admin API only; keep these values server-side and out of NEXT_PUBLIC_*.
# Configure these only after the owner completes the setup in README.md.
FIREBASE_PROJECT_ID=pokhars-store
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_UIDS=
# Optional alternative: verified Firebase Auth email addresses, comma-separated.
ADMIN_EMAILS=

# Keep true while sample product details/images/prices are being used.
# Demo products remain visible, but all order/payment flows are disabled.
# Set false only after replacing sample data with approved retail product information.
NEXT_PUBLIC_CATALOGUE_DEMO_MODE=true

# App Check site key (optional; configure after basic auth/database setup).
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Razorpay secrets are server-only. Never prefix these with NEXT_PUBLIC_.
# Checkout accepts test mode only; live payment keys are rejected by the server.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional fixed test shipping charge in paise (default 0). Taxes are not included.
CHECKOUT_TEST_SHIPPING_PAISE=0

# ImageKit upload authentication. These values are server-only; never use NEXT_PUBLIC_ for the private key.
# The admin upload route creates short-lived signatures; product image files upload directly to ImageKit.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
