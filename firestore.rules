rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admin is a Firebase Auth custom claim set only by trusted Admin SDK code.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /products/{productId} {
      allow get, list: if isAdmin() ||
        (resource.data.isActive == true && resource.data.visibility == "published");
      // Product prices, visibility and stock are changed only by trusted server code.
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if ownsUser(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly([
          "uid", "displayName", "email", "photoURL", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "uid", "displayName", "email", "photoURL", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid == userId;

      allow update: if ownsUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName", "email", "photoURL", "updatedAt"
        ]);

      allow delete: if false;

      match /cart/{productId} {
        allow read: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasOnly(["productId", "quantity", "updatedAt"])
          && request.resource.data.keys().hasAll(["productId", "quantity"])
          && request.resource.data.productId == productId
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity <= 20;
        allow delete: if ownsUser(userId);
      }

      match /addresses/{addressId} {
        allow read: if ownsUser(userId);
        allow create, update: if ownsUser(userId)
          && request.resource.data.keys().hasOnly([
            "recipientName", "phone", "line1", "line2", "landmark",
            "city", "state", "pincode", "isDefault", "createdAt", "updatedAt"
          ])
          && request.resource.data.keys().hasAll([
            "recipientName", "phone", "line1", "city", "state",
            "pincode", "isDefault", "createdAt", "updatedAt"
          ])
          && request.resource.data.recipientName is string
          && request.resource.data.phone is string
          && request.resource.data.line1 is string
          && request.resource.data.city is string
          && request.resource.data.state is string
          && request.resource.data.pincode is string
          && request.resource.data.isDefault is bool;
        allow delete: if ownsUser(userId);
      }
    }

    match /orders/{orderId} {
      allow get, list: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      // Order records, prices, totals, statuses and payment state are server-written.
      allow create, update, delete: if false;
    }

    match /coupons/{couponId} {
      allow get, list: if isAdmin() || resource.data.isActive == true;
      allow create, update, delete: if false;
    }

    match /settings/public {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
